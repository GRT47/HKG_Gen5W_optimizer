{
  "id": "hkg-optimize",
  "version": "1.0.2",
  "name": "HKG 5W Optimize",
  "description": "Gen5W 무상주 반응성 최적화 홈 화면 바로가기",
  "apps": [
    {
      "package": "com.hkg.optimize.app",
      "apk": "HkgOptimizeShortcut.apk"
    }
  ],
  "services": [
    {
      "name": "open-ui",
      "script": "bin/open-ui.sh",
      "user": "root",
      "start": "manual",
      "restart": false
    }
  ],
  "provides": {
    "launcher": [
      {
        "title": "HKG 최적화",
        "package": "com.hkg.optimize.app",
        "class": ".LaunchActivity",
        "icon": "icon.png",
        "icon_night": "icon_night.png",
        "icon_disabled": "icon_disabled.png",
        "icon_disabled_night": "icon_disabled_night.png"
      }
    ]
  }
}
